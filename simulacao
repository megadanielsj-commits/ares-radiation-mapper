#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
export ARES_SIMULATION_ROOT="$PWD"
export ARES_SIMULATION_UID="$(id -u)" ARES_SIMULATION_GID="$(id -g)"
compose=(docker compose -f "$PWD/tools/source_simulation/compose.yaml")
command -v docker >/dev/null || { echo 'Falta Docker Engine.' >&2; exit 2; }
docker compose version >/dev/null
mkdir -p resultados/fonte-simulada
case "${1:-iniciar}" in
  iniciar)
    "${compose[@]}" down --timeout 45 --remove-orphans
    python3 - <<'PORT_CHECK'
import socket
with socket.socket() as probe:
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind(('127.0.0.1', 8001))
    except OSError:
        raise SystemExit('Porta 8001 ocupada. Pare o ensaio USB antes de iniciar a simulação.')
PORT_CHECK
    if ! docker image inspect ares-source-simulation:classic-20261001-r2 >/dev/null 2>&1; then
      "${compose[@]}" build simulation
    fi
    if ! "${compose[@]}" up -d --no-build --wait --wait-timeout 45; then
      "${compose[@]}" logs --no-color --tail 80
      exit 1
    fi
    echo 'Simulador original: fonte, detector e robô simulados.'
    echo 'Painel: http://127.0.0.1:8001 | Clique em Iniciar mapeamento e use as setas.'
    echo 'A taxa da fonte a 1 metro é informada em mSv/h, como no painel original.'
    echo 'Parar e salvar: bash simulacao parar'
    ;;
  parar)
    "${compose[@]}" down --timeout 45 --remove-orphans
    echo "Dados e exportações preservados em $PWD/resultados/fonte-simulada"
    ;;
  verificar)
    "${compose[@]}" ps -a
    "${compose[@]}" logs --no-color --tail 40
    ;;
  *) echo 'Uso: bash simulacao iniciar | parar | verificar' >&2; exit 2 ;;
esac
