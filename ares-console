#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
export ARES_CONSOLE_ROOT="$PWD"
export ARES_CONSOLE_UID="$(id -u)" ARES_CONSOLE_GID="$(id -g)"
export ARES_USB_LOCK_DIR="${ARES_RADIACODE_LOCK_DIR:-${XDG_RUNTIME_DIR:-/tmp}/ares-radiacode-locks}"
mkdir -p resultados/console "$ARES_USB_LOCK_DIR"
compose=(docker compose -f "$PWD/tools/operator_console/compose.yaml")
command -v docker >/dev/null || { echo 'Falta Docker Engine.' >&2; exit 2; }
docker compose version >/dev/null
case "${1:-iniciar}" in
  iniciar)
    if test -n "$(docker ps -aq --filter label=com.docker.compose.project=ares-operator-console)"; then
      "${compose[@]}" down --timeout 45 --remove-orphans
    fi
    mapfile -t ARES_PREVIOUS_SIMULATIONS < <(docker ps -q --filter label=com.docker.compose.project=ares-source-simulation)
    if ((${#ARES_PREVIOUS_SIMULATIONS[@]})); then
      echo 'Encerrando e salvando o painel anterior da fonte simulada.'
      docker stop --time 45 "${ARES_PREVIOUS_SIMULATIONS[@]}" >/dev/null
    fi
    python3 - <<'CHECK_PORT'
import socket
with socket.socket() as probe:
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind(('127.0.0.1',8001))
    except OSError:
        raise SystemExit('Porta 8001 ocupada. Pare o painel anterior com o iniciador dele antes de abrir o console.')
CHECK_PORT
    if ! docker image inspect ares-operator-console:20261002-r1 >/dev/null 2>&1; then
      "${compose[@]}" build console
    fi
    if ! "${compose[@]}" up -d --no-build --wait --wait-timeout 75; then
      "${compose[@]}" logs --no-color --tail 80
      exit 1
    fi
    echo 'ARES: http://127.0.0.1:8001'
    echo 'Inicia em simulação completa. Selecione as entradas no próprio console.'
    echo 'Encerrar a missão: botão Encerrar e salvar. Parar o sistema: bash ares-console parar'
    ;;
  parar)
    "${compose[@]}" down --timeout 45 --remove-orphans
    echo "Dados preservados em $PWD/resultados/console"
    ;;
  verificar)
    "${compose[@]}" ps -a
    "${compose[@]}" logs --no-color --tail 60
    ;;
  *) echo 'Uso: bash ares-console iniciar | parar | verificar' >&2; exit 2 ;;
esac
