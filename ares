#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    printf 'Uso: ./ares simulation | ./ares hardware\n'
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        printf 'Erro: Docker não está instalado.\n' >&2
        exit 2
    fi
    if ! docker compose version >/dev/null 2>&1; then
        printf 'Erro: o plugin Docker Compose não está disponível.\n' >&2
        exit 2
    fi
}

mode="${1:-}"
require_docker

case "$mode" in
    simulation)
        exec docker compose --profile simulation up --build --remove-orphans simulation
        ;;
    hardware)
        if [[ ! -f .env ]]; then
            printf 'Falta o arquivo .env. Execute: cp .env.example .env\n' >&2
            printf 'Depois informe nele a interface conectada ao Go2.\n' >&2
            exit 2
        fi

        set -a
        # shellcheck disable=SC1091
        source .env
        set +a

        if [[ -z "${ARES_NETWORK_INTERFACE:-}" ]]; then
            printf 'Erro: defina ARES_NETWORK_INTERFACE no arquivo .env.\n' >&2
            exit 2
        fi

        FS5000_DEVICE="${FS5000_DEVICE:-/dev/ttyUSB0}"
        export FS5000_DEVICE

        if ! ip link show "$ARES_NETWORK_INTERFACE" >/dev/null 2>&1; then
            printf 'Erro: interface de rede "%s" não encontrada.\n' "$ARES_NETWORK_INTERFACE" >&2
            printf 'Confira os nomes com: ip -br link\n' >&2
            exit 2
        fi

        if [[ ! -c "$FS5000_DEVICE" ]]; then
            printf 'Erro: FS-5000 não encontrado em "%s".\n' "$FS5000_DEVICE" >&2
            printf 'Confira as portas com: ls -l /dev/ttyUSB* /dev/ttyACM* 2>/dev/null\n' >&2
            exit 2
        fi

        exec docker compose --profile hardware up --build --remove-orphans hardware
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
