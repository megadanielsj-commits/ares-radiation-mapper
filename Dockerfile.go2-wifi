# Test image only; Werik's original Dockerfile and FS-5000 profiles are preserved.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-go2-wifi.txt pyproject.toml ./
COPY src ./src
RUN python -m pip install -r requirements-go2-wifi.txt \
 && python -m pip install --no-deps unitree_webrtc_connect==2.2.0 \
 && python -m pip install --no-deps .
COPY tools/check_installed_app.py /app/tools/check_installed_app.py
# Validate the installed package, which is the actual runtime used by the image.
RUN python /app/tools/check_installed_app.py --robot-imports
CMD ["python", "-m", "ares"]
