#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
export ARES_DETECTOR_ROOT ARES_ROBOT_ROOT ARES_DOCKER_UID ARES_DOCKER_GID ARES_USB_LOCK_DIR
ARES_DETECTOR_ROOT="$PWD"
ARES_DOCKER_UID="$(id -u)"
ARES_DOCKER_GID="$(id -g)"
ARES_USB_LOCK_DIR="/tmp/ares-radiacode-lock-$ARES_DOCKER_UID"
if [[ -z "${ARES_ROBOT_ROOT:-}" ]]; then
  if [[ -f integracao-go2/src/ares/config.py ]]; then
    ARES_ROBOT_ROOT="$PWD/integracao-go2"
  else
    ARES_ROBOT_ROOT="$(dirname "$PWD")/ares-go2-wifi"
  fi
fi
compose=(docker compose -f "$PWD/tools/integration/compose.yaml")
mode="${1:-}"
if [[ "$mode" == exportar ]]; then
  exec python3 tools/integration/export_sessions.py resultados/integracao
fi
command -v docker >/dev/null || { echo 'Falta Docker Engine.' >&2; exit 2; }
docker compose version >/dev/null
docker info >/dev/null

ensure_sources() {
  if [[ ! -f "$ARES_ROBOT_ROOT/src/ares/radiacao/radiacode.py" ]]; then
    if git show-ref --verify --quiet refs/heads/feat/radiacode-go2-wifi; then
      git worktree add --detach "$ARES_ROBOT_ROOT" feat/radiacode-go2-wifi
    else
      echo 'Falta o módulo Go2/WebRTC. Use o ZIP completo ou importe as duas branches do bundle.' >&2
      exit 2
    fi
  fi
  mkdir -p resultados/integracao/{usb,simulacao,real} "$ARES_USB_LOCK_DIR"
}

stop_previous_integration() {
  # Select only containers from this project's integration images. Keep data,
  # images, volumes and unrelated robot control projects intact.
  local containers=()
  while IFS='|' read -r container image project; do
    if [[ "$image" == ares-radiacode-* && "$project" == ares-radiacode-* ]]; then
      containers+=("$container")
    fi
  done < <(docker ps --format '{{.ID}}|{{.Image}}|{{.Label "com.docker.compose.project"}}')
  if (( ${#containers[@]} )); then
    echo 'Encerrando a versão anterior da integração ARES; arquivos de dados serão preservados.'
    docker stop --time 30 "${containers[@]}" >/dev/null
  fi
}

show_failure() {
  local directory
  directory="resultados/integracao/diagnostico-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$directory"
  "${compose[@]}" --profile simulado --profile real ps -a > "$directory/containers.txt" 2>&1 || true
  "${compose[@]}" --profile simulado --profile real logs --no-color --tail 100 > "$directory/services.log" 2>&1 || true
  cat "$directory/containers.txt"
  cat "$directory/services.log"
  echo "Diagnóstico salvo: $PWD/$directory"
}

case "$mode" in
  preparar)
    ensure_sources
    "${compose[@]}" --profile simulado build usb ares-usb-simulado
    echo 'Validando a aplicação instalada na imagem...'
    docker run --rm --network none --entrypoint python ares-radiacode-go2:20260930-r2 /app/tools/check_installed_app.py --robot-imports
    docker run --rm --network none --entrypoint python ares-radiacode-service:20260930-r2 \
      -c 'import usb.backend.libusb1, radiacode; assert usb.backend.libusb1.get_backend() is not None; print("Backend USB disponível")'
    echo 'Imagens construídas e painel verificado. O preparo não exige Radiacode nem Go2 conectado.'
    echo 'Primeiro teste: bash ensaio usb-simulado | No Wi-Fi do Go2, no laboratório: bash ensaio usb-robo'
    ;;
  usb-simulado|usb-robo)
    ensure_sources
    if ! docker image inspect ares-radiacode-service:20260930-r2 ares-radiacode-go2:20260930-r2 >/dev/null 2>&1; then
      echo 'Execute primeiro: bash ensaio preparar (com internet).'
      exit 2
    fi
    [[ -d /dev/bus/usb ]] || { echo 'USB não encontrado neste Linux.' >&2; exit 2; }
    stop_previous_integration
    "${compose[@]}" --profile simulado --profile real down
    if command -v flock >/dev/null && ! flock -n "$ARES_USB_LOCK_DIR/ares-radiacode-usb-$ARES_DOCKER_UID.lock" true; then
      echo 'Outro leitor USB está ativo. Encerre-o com Ctrl+C antes deste teste.' >&2
      exit 2
    fi
    python3 tools/integration/check_services.py --ports
    if [[ "$mode" == usb-robo ]]; then
      profile=real
      application=ares-usb-real
      echo 'Modo: Radiacode USB e odometria Go2/WebRTC. Nenhuma missão ou movimento automático.'
    else
      profile=simulado
      application=ares-usb-simulado
      echo 'Modo: Radiacode USB e odometria simulada. O robô físico não é necessário.'
    fi
    if ! "${compose[@]}" --profile "$profile" up -d --no-build --wait --wait-timeout 45 usb "$application"; then
      show_failure
      exit 1
    fi
    if ! python3 tools/integration/check_services.py --mode "$mode"; then
      show_failure
      exit 1
    fi
    echo 'Diagnóstico: bash ensaio verificar | Encerrar e exportar: bash ensaio parar'
    ;;
  verificar)
    "${compose[@]}" --profile simulado --profile real ps -a
    python3 tools/integration/check_services.py
    "${compose[@]}" --profile simulado --profile real logs --no-color --tail 40
    ;;
  parar)
    "${compose[@]}" --profile simulado --profile real down
    stop_previous_integration
    python3 tools/integration/export_sessions.py resultados/integracao
    echo "Dados preservados em $PWD/resultados/integracao"
    ;;
  logs)
    exec "${compose[@]}" --profile simulado --profile real logs --tail 100 -f
    ;;
  *)
    echo 'Uso: bash ensaio preparar | usb-simulado | usb-robo | verificar | logs | parar | exportar' >&2
    exit 2
    ;;
esac
