#!/usr/bin/env bash
# Diagnostico read-only: o Go2 esta entregando DDS (pose) para este host?
# Nao comanda o robo. Requer a imagem ares-radiation-mapper:hardware.
# Uso: ./diagnose-go2-dds [iface] [domain] [segundos]
set -Eeuo pipefail
cd "$(dirname "$0")"

IFACE="${1:-enp7s0}"
DOMAIN="${2:-0}"
SECS="${3:-10}"

if ! docker image inspect ares-radiation-mapper:hardware >/dev/null 2>&1; then
    printf 'Imagem hardware ausente. Rode antes: docker compose --profile hardware build hardware\n' >&2
    exit 2
fi

exec docker run --rm --network host \
    -v "$PWD/tools/go2_dds_probe.py:/go2_dds_probe.py:ro" \
    --entrypoint python \
    ares-radiation-mapper:hardware \
    /go2_dds_probe.py "$IFACE" "$DOMAIN" "$SECS"
